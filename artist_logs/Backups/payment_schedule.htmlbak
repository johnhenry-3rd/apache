{% extends "artist_logs/base.html" %}

{% block content %}
<div class="container">
    <h1>Royalty Payment Schedule by Composer</h1>

    <!-- Back to List Link -->
    <div class="mb-3">
        <a href="{% url 'artist_logs:prs_data_list' %}" class="btn btn-secondary">
            ← Back to PRS Data List
        </a>
    </div>

    <!-- Summary Statistics -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Total Royalty Payable</h5>
                    <p class="card-text">£{{ grand_total|floatformat:2 }}</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Number of Composers</h5>
                    <p class="card-text">{{ total_composers }}</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Number of Songs</h5>
                    <p class="card-text">{{ total_songs }}</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Number of Payments</h5>
                    <p class="card-text">{{ individual_payments|length }}</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Composer Summary Table -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h2>Composer Summary</h2>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-bordered">
                    <thead class="thead-dark">
                        <tr>
                            <th>Composer</th>
                            <th class="text-right">Total Royalty</th>
                            <th class="text-right">Songs</th>
                            <th class="text-right">Payments</th>
                            <th class="text-right">% of Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for composer in composer_totals %}
                        <tr>
                            <td><strong>{{ composer.Composer }}</strong></td>
                            <td class="text-right">£{{ composer.total_royalty|floatformat:2 }}</td>
                            <td class="text-right">{{ composer.song_count }}</td>
                            <td class="text-right">{{ composer.payment_count }}</td>
                            <td class="text-right">
                                {{ composer.percentage|floatformat:2 }}%
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                    <tfoot>
                        <tr>
                            <th>Total</th>
                            <th class="text-right">£{{ grand_total|floatformat:2 }}</th>
                            <th class="text-right">{{ total_songs }}</th>
                            <th class="text-right">{{ individual_payments|length }}</th>
                            <th class="text-right">100%</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <!-- Detailed Payment Breakdown -->
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h2>Detailed Payment Breakdown by Individual Composer</h2>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="thead-dark">
                        <tr>
                            <th>Composer</th>
                            <th>Song Code</th>
                            <th>Song Title</th>
                            <th>Artist</th>
                            <th>Client</th>
                            <th>Period</th>
                            <th class="text-right">Royalty Payable</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for payment in individual_payments %}
                        <tr>
                            <td>{{ payment.Composer }}</td>
                            <td>{{ payment.Song_Code }}</td>
                            <td>{{ payment.Song_Title }}</td>
                            <td>{{ payment.Artist }}</td>
                            <td>{{ payment.Client_Code }}</td>
                            <td>{{ payment.Income_Period }}</td>
                            <td class="text-right">£{{ payment.Royalty_Payable|floatformat:2 }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="6" class="text-right">Total:</th>
                            <th class="text-right">£{{ grand_total|floatformat:2 }}</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Custom CSS for this page -->
<style>
    .card {
        margin-bottom: 20px;
        border: 1px solid #dee2e6;
        border-radius: 0.25rem;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }
    .card-header {
        padding: 0.75rem 1.25rem;
        margin-bottom: 0;
        background-color: #007bff;
        border-bottom: 1px solid #dee2e6;
    }
    .card-body {
        padding: 1.25rem;
    }
    .table {
        width: 100%;
        margin-bottom: 1rem;
        color: #212529;
    }
    .table th,
    .table td {
        padding: 0.75rem;
        vertical-align: top;
        border-top: 1px solid #dee2e6;
    }
    .table thead th {
        vertical-align: bottom;
        border-bottom: 2px solid #dee2e6;
    }
    .table tbody + tbody {
        border-top: 2px solid #dee2e6;
    }
    .table .table-bordered {
        border: 1px solid #dee2e6;
    }
    .table .table-bordered th,
    .table .table-bordered td {
        border: 1px solid #dee2e6;
    }
    .text-right {
        text-align: right;
    }
    .btn {
        display: inline-block;
        font-weight: 400;
        text-align: center;
        white-space: nowrap;
        vertical-align: middle;
        user-select: none;
        border: 1px solid transparent;
        padding: 0.375rem 0.75rem;
        font-size: 1rem;
        line-height: 1.5;
        border-radius: 0.25rem;
        transition: color 0.15s ease-in-out, background-color 0.15s ease-in-out, border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
    }
    .btn-secondary {
        color: #fff;
        background-color: #6c757d;
        border-color: #6c757d;
    }
    .btn-secondary:hover {
        color: #fff;
        background-color: #5a6268;
        border-color: #545b62;
    }
    .thead-dark th {
        color: #fff;
        background-color: #343a40;
        border-color: #454d55;
    }
    .bg-primary {
        background-color: #007bff !important;
    }
    .text-white {
        color: #fff !important;
    }
</style>
{% endblock %}